      "get": {
        "tags": [
          "discovery"
        ],
        "summary": "GET /jwks.json — returns the JSON Web Key Set for token verification.",
        "operationId": "jwks",
        "responses": {
          "200": {
            "description": "JSON Web Key Set"
          }
        }
      }
    },
    "/token": {
      "post": {
        "tags": [
          "token-exchange"
        ],
        "summary": "POST /token — RFC 8693 token exchange endpoint.",
        "description": "Orchestrates: validate identity → rate limit → resolve billets → implicit mapping\n→ token assembly → issue JWT → (optional) issue cert → audit log → return response.\n\nIdentity resolution precedence:\n1. If `subject_token` is present → use token dispatch (existing path)\n2. If absent, try mTLS identity from client certificate extension\n3. If neither available → return 400",
        "operationId": "token_exchange",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenExchangeForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Token exchange successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenExchangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "MutualTLS": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AdminBilletMetadataResponse": {
        "type": "object",
        "description": "Response body for a billet metadata record.",
        "required": [
          "name",
          "description",
          "associated_aws_roles",
          "associated_gcp_sas",
          "tags",
          "updated_at"
        ],
        "properties": {
          "associated_aws_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "associated_gcp_sas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "BilletDiscoveryForm": {
        "type": "object",
        "description": "Form body for the billet discovery request.",
        "properties": {
          "subject_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject_token_type": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "BilletDiscoveryResponse": {
        "type": "object",
        "description": "JSON response for billet discovery.",
        "required": [
          "billets",
          "implicit_billets",
          "cedar_billets"
        ],
        "properties": {
          "billets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cedar_billets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implicit_billets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "BilletListItem": {
        "type": "object",
        "description": "Represents a billet in the list response.",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "BilletMetadataResponse": {
        "type": "object",
        "description": "Response body for billet metadata.",
        "required": [
          "name",
          "description",
          "associated_aws_roles",
          "associated_gcp_sas"
        ],
        "properties": {
          "associated_aws_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "associated_gcp_sas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
