      "get": {
        "tags": [
          "discovery"
        ],
        "summary": "GET /ca/chain.pem — returns the CA certificate chain in PEM format.",
        "operationId": "ca_chain",
        "responses": {
          "200": {
            "description": "CA certificate chain in PEM format",
