    "/billets/me": {
      "post": {
        "tags": [
          "discovery"
        ],
        "summary": "POST /billets/me — discover entitled billets without issuing a token.",
        "description": "Performs steps 1–7 of the token exchange flow (validate identity → rate limit →\nresolve billets → implicit mapping → assemble), then returns the resolution\ndirectly as a JSON response.\n\nReturns 200 with empty arrays when the caller has no entitled billets (graceful).",
        "operationId": "billet_discovery",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/BilletDiscoveryForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Discovery result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BilletDiscoveryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "MutualTLS": []
          }
        ]
      }
    },
    "/billets/{name}": {
      "get": {
        "tags": [
          "discovery"
        ],
        "summary": "GET /billets/:name — retrieve billet metadata for data-plane callers.",
        "description": "Requires a valid Quartermaster JWT. Evaluates `readBillet` authorization\nvia the local Cedar evaluator before returning metadata.",
        "operationId": "get_billet",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Billet name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
