      "get": {
        "tags": [
          "system"
        ],
        "summary": "GET /healthz — health check endpoint.",
        "description": "Returns 200 if healthy or degraded, 503 if unhealthy.\nChecks DataStore connectivity, KeyManager health, and PolicySync initialization.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Service healthy or degraded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
